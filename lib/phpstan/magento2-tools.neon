parameters:
    level: 1

    # bitexpert/phpstan-magento is loaded (via runtime neon include) with the
    # correct magentoRoot, so its ClassLoaderProvider bootstraps Magento's
    # vendor/autoload.php — resolving all framework classes natively.
    # Factory/Proxy stubs are generated by phpstan-magento's autoloaders.
    ignoreErrors: []
    reportUnmatchedIgnoredErrors: true
