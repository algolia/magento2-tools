parameters:
    level: 1

    # Tier 1: Standalone analysis without a Magento root.
    # bitexpert/phpstan-magento is NOT loaded in this tier (its autoloaders
    # throw internal errors when framework classes are unavailable).
    #
    # A dynamic stub autoloader generates empty class/interface definitions for
    # Magento\* and Zend_* classes on-the-fly. This prevents PHPStan's non-ignorable
    # "extends unknown class" errors without requiring maintained stub files.
    #
    # Identifier-based ignoreErrors then suppresses the cascading errors from empty
    # stubs (undefined methods, constants, properties inherited from framework classes).
    # What remains are errors within the extension's own code.
    bootstrapFiles:
        - magento-stub-autoloader.php

    ignoreErrors:
        # Undefined methods/constants/properties from empty Magento stubs
        -
            identifier: class.notFound
        -
            identifier: function.notFound
        -
            identifier: constant.notFound

    reportUnmatchedIgnoredErrors: false
